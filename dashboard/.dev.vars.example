# Copy to .dev.vars for local dev. In production use `npx wrangler secret put <NAME>`.
# Google: Settings → your calendar → Integrate calendar → "Secret address in iCal format".
# iCloud: Calendar app → right-click the calendar → Share Calendar → Public Calendar → copy link.
CALENDAR_URLS="https://calendar.google.com/calendar/ical/.../basic.ics webcal://p00-caldav.icloud.com/published/2/..."
# Optional: names for the Calendars show/hide list, comma-separated, in the same order as the links.
# CALENDAR_NAMES="Personal, Family, Work"
# Optional colours, same order: red, orange, yellow, green, teal, blue, indigo, purple, pink, brown,
# gray, or #rrggbb. Unset calendars rotate through red, blue, green, purple, orange, teal.
# CALENDAR_COLORS="blue, yellow, green"
# Any long random string. The frame opens the dashboard once with ?key=<this>.
DASHBOARD_KEY=""
# Optional: IANA zone for event times that carry no zone at all (rare). Defaults to the feed's own.
# DISPLAY_TZ="America/Chicago"
# Todoist → Settings → Integrations → Developer → API token.
TODOIST_TOKEN=""
# Optional: weather location (rounded is fine) and unit.
# WEATHER_LAT="40.71"
# WEATHER_LON="-74.01"
# WEATHER_UNIT="celsius"
# Optional: iCloud Shared Album with "Public Website" on, for the idle slideshow.
# ALBUM_URL="https://photos.icloud.com/shared/album/<token>"
# Optional: token AI agents use to post messages and save recipes (any long random string).
# AGENT_TOKEN=""
# Optional: a Paprika Cloud Sync account, to show your own recipes (read-only).
# PAPRIKA_EMAIL=""
# PAPRIKA_PASSWORD=""

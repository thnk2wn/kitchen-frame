# Copy to .dev.vars for local dev. In production use `npx wrangler secret put <NAME>`
# (or scripts/push-secrets.sh). Grouped by what they're for; only Required is needed.

# ---- Required ----------------------------------------------------
# iCal links, separated by spaces (docs/calendar.md): Google "Secret address in iCal format",
# an iCloud public link, Fastmail, Outlook; or bridge:<name> for an Apple calendar through the Mac.
CALENDAR_URLS="https://calendar.google.com/calendar/ical/.../basic.ics webcal://p00-caldav.icloud.com/published/2/..."
# Any long random string (openssl rand -hex 24). The frame opens the dashboard once with ?key=<this>.
DASHBOARD_KEY=""

# ---- Agents ------------------------------------------------------
# Optional: AI agents and scripts that post messages and save recipes (docs/messages.md).
# AGENT_TOKEN=""

# ---- Alexa -------------------------------------------------------
# Optional: your own Alexa skill, "Alexa, ask Frame to…" (docs/alexa.md).
# Its skill id from the Alexa developer console (amzn1.ask.skill.…).
# ALEXA_SKILL_ID=""
# Only these Amazon accounts (amzn1.ask.account.…, space-separated); the Worker log shows yours.
# ALEXA_USER_IDS=""

# ---- Calendar ----------------------------------------------------
# Optional, each in the same order as CALENDAR_URLS (docs/calendar.md).
# Colours: red, orange, yellow, green, teal, blue, indigo, purple, pink, brown, gray or #rrggbb.
# CALENDAR_COLORS="blue, yellow, green"
# yes for calendars whose events open with their details and notes when tapped.
# CALENDAR_DETAILS="yes, yes, no"
# Names for the Calendars show/hide list.
# CALENDAR_NAMES="Personal, Family, Work"
# IANA zone for event times that carry no zone at all (rare). Defaults to the feed's own.
# DISPLAY_TZ="America/Chicago"

# ---- Demo mode ---------------------------------------------------
# Optional: on a frame with Home Assistant, demo mode's Media tab stays live (docs/frame.md).
# Names to show instead, as JSON (speakers, TVs, Spotify devices, Videos groups).
# DEMO_NAMES='{"Den":"Living Room TV","Sam":"Kiddo"}'
# Public Spotify playlist links for its Music row, separated by spaces (default: a dinner-time mix).
# DEMO_PLAYLISTS="https://open.spotify.com/playlist/..."

# ---- Development -------------------------------------------------
# Local only: with no DASHBOARD_KEY, 1 lets the API answer without one. Never in production.
# ALLOW_NO_KEY="1"

# ---- Lists -------------------------------------------------------
# Groceries and Tasks (docs/lists.md): Todoist by default, or a list from Apple Reminders through
# the Mac bridge ("reminders"; list names as in Reminders).
# GROCERIES_SOURCE="reminders"
# Sections, flags and assignees from the Reminders database (Full Disk Access on the Mac).
# REMINDERS_EXTRAS="on"
# REMINDERS_GROCERIES_LIST="Groceries"
# REMINDERS_TODO_LIST="To Do"
# Todoist → Settings → Integrations → Developer → API token.
TODOIST_TOKEN=""
# TODO_SOURCE="reminders"

# ---- Mac bridge and camera relay ---------------------------------
# Optional: a Mac at home (docs/mac-bridge.md, docs/house.md).
# The bridge's token: any long random string; set the same on the Mac.
# BRIDGE_TOKEN=""
# The camera relay's address(es) with its token, space-separated (bridge/camera-relay/).
# CAMERA_RELAY="http://<mac>:1985/<token>/?cameras=<name>,<name>"

# ---- Music and videos --------------------------------------------
# Optional (docs/music.md).
# A phone's share sheet plays a YouTube video on the frame with this (and nothing else).
# SHARE_TOKEN=""
# A Spotify developer app (redirect URI http://127.0.0.1:8888/callback), for every playlist and
# what was last played; then node scripts/spotify-auth.mjs fills in the refresh token.
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""
# SPOTIFY_REFRESH_TOKEN=""
# YouTube Data API v3 key, restricted to that API: whole playlists (without it, 15 newest each).
# YOUTUBE_API_KEY=""
# Media → Videos: groups of video and playlist links, separated by |.
# YOUTUBE_VIDEOS="Songs: https://www.youtube.com/playlist?list=PL... | Trucks: https://youtu.be/... https://youtu.be/..."

# ---- Notices -----------------------------------------------------
# Optional (docs/notices.md); the defaults suit most.
# Blue info notices still on after this many hours are dismissed (default 24; 0 = never).
# NOTICES_INFO_HOURS="24"
# How long ended notices are kept (default 24, up to 168).
# NOTICES_KEEP_HOURS="24"
# How many at most (default 50, up to 200).
# NOTICES_KEEP_MAX="50"

# ---- Photos ------------------------------------------------------
# Optional: the slideshow's iCloud shared album (docs/presence.md).
# Its link with Public Website on, or bridge:<album name> through the Mac (no public link).
# ALBUM_URL="https://photos.icloud.com/shared/album/<token>"

# ---- Recipes -----------------------------------------------------
# Optional: a Paprika Cloud Sync account, for your own recipes and meal plan (docs/recipes.md).
# PAPRIKA_EMAIL=""
# PAPRIKA_PASSWORD=""

# ---- Rotations ---------------------------------------------------
# Optional: who's up early, whose bedtime, as JSON (docs/rotations.md has the format).
# ROTATIONS='[{"name":"Bedtime","icon":"moon","alternate":{"from":"2026-10-15","who":["Alex","Sam"]}}]'

# ---- Weather -----------------------------------------------------
# Optional: the location (rounded is fine) and unit.
# WEATHER_LAT="40.71"
# WEATHER_LON="-74.01"
# WEATHER_UNIT="celsius"

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kitchen-frame",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  // The Vite plugin builds the dashboard into the asset bundle; the Worker only handles /api/*.
  // The Worker serves the page itself (to mark it no-store); everything else is a plain asset.
  "assets": { "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  // Created on the first deploy (2026-10-13) as "kitchen-frame-calendar".
  "kv_namespaces": [{ "binding": "CALENDAR", "id": "c402f7fac06e4d6c9c3038dc91efc42b" }],
  // Agent messages: one SQLite-backed Durable Object holding the list and the frames' WebSockets
  // (hibernation API, so idle connections cost nothing). See worker/messages.js.
  "durable_objects": { "bindings": [{ "name": "MESSAGES", "class_name": "MessageRoom" }, { "name": "BRIDGE", "class_name": "ListBridge" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MessageRoom"] }, { "tag": "v2", "new_sqlite_classes": ["ListBridge"] }],
  // Calendar refresh every 10 minutes; Paprika recipe sync every 15 (worker/index.js).
  "triggers": { "crons": ["*/10 * * * *", "*/15 * * * *"] },
  // Resizes photos of saved recipes once, when saved (worker/recipes.js).
  "images": { "binding": "IMAGES" },
  // Todoist project names shown as the Groceries and Tasks lists.
  "vars": { "TODOIST_GROCERY_PROJECT": "Groceries", "TODOIST_TODO_PROJECT": "Family" },
  "observability": { "enabled": true }
}
